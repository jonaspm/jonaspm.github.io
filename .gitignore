# https://git-scm.com/docs/gitignore
# https://help.github.com/articles/ignoring-files
# Example .gitignore files: https://github.com/github/gitignore
bower_components/
node_modules/
build/
dist/
.vscode/
.astro/
.wrangler/
package-lock.json

# Local environment secrets
.env
.env.*
!.env.example

# D1 export artifacts (bun run db:export)
backups/

# EmDash generated migration manifest (rewritten by every build; not committed).
# Keep the rest of .emdash/ trackable (e.g. .emdash/seed.json).
.emdash/migrations.json