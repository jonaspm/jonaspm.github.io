		"astro": "7.3.8",
		"emdash": "^1.2.0",
		"kysely": "^0.29.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"wrangler": "^4.125.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "1.10.12",
		"@biomejs/biome": "^2.5.15",
		"@material-symbols/font-400": "^0.47.6",
