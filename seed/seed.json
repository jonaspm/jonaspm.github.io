{
	"version": "1",
	"defaultLocale": "en",
	"meta": {
		"name": "jonasperusquia.com",
		"description": "Portfolio posts (projects & articles) with en/es/eo translations"
	},
	"settings": {
		"title": "Jonas Perusquia Morales",
		"tagline": "Msc. Data Science & Software Engineer"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"description": "Portfolio projects and articles",
			"icon": "article",
			"supports": ["drafts", "revisions", "preview", "scheduling"],
			"urlPattern": "/portfolio/{slug}",
			"routable": true,
			"titleField": "title",
			"dateField": "date",
			"admin": {
				"listColumns": ["date", "sort_order"],
				"quickCreate": false
			},
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"translatable": true
				},
				{
					"slug": "url",
					"label": "External URL",
					"type": "url",
					"required": false,
					"translatable": false
				},
				{
					"slug": "image",
					"label": "Image",
					"type": "image",
					"required": false,
					"translatable": false
				},
				{
					"slug": "sort_order",
					"label": "Order",
					"type": "integer",
					"required": false,
					"translatable": false,
					"indexed": true,
					"defaultValue": 0
				},
				{
					"slug": "date",
					"label": "Date",
					"type": "datetime",
					"required": false,
					"translatable": false
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"required": true,
					"translatable": true,
					"widget": "textarea"
				},
				{
					"slug": "body",
					"label": "Body",
					"type": "text",
					"required": true,
					"translatable": true,
					"widget": "textarea"
				},
				{
					"slug": "skills",
					"label": "Skills",
					"type": "json",
					"required": false,
					"translatable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": ["posts"],
			"terms": [
				{
					"id": "term:category:project:en",
					"slug": "project",
					"label": "Project"
				},
				{
					"id": "term:category:article:en",
					"slug": "article",
					"label": "Article"
				},
				{
					"id": "term:category:project:es",
					"slug": "project",
					"label": "Proyecto",
					"locale": "es",
