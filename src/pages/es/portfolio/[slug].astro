---
// Spanish detail route: `/es/portfolio/{slug}`.
//
// Data loading and the 404 guard live in the page (not inside PostDetail):
// `return Astro.rewrite(...)` only works from pages/middleware — a nested
// component returning a `Response` throws `ResponseSentError` during SSR.
import PostDetail from '@/components/PostDetail.astro'
import { getPost } from '@/utils/emdash-posts'
import type { Language } from '@/utils/i18n'

const language: Language = 'es'
const slug = Astro.params.slug
const post = slug ? await getPost(language, slug) : null

// Missing or unpublished slug → rewrite to the /404 route, which renders with
// a 404 status (Astro's error route default).
if (!post) {
	return Astro.rewrite('/404')
}
---

<PostDetail post={post} language={language} />
