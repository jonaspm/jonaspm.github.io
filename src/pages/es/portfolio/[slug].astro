---
import { Image } from 'astro:assets'
import { type CollectionEntry, getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'
import autosolutionsImage from '@/assets/images/autosolutions.mx.png'
import enerlinqImage from '@/assets/images/enerlinq.com.png'
import gerardoAncerImage from '@/assets/images/gerardoancer.com.png'
import hackcuuImage from '@/assets/images/hackcuu.com.png'
import petwebyImage from '@/assets/images/petweby.com.png'
import sorteosClickImage from '@/assets/images/sorteos.click.png'
import Layout from '@/layouts/Layout.astro'
import {
	getTranslations,
	type Language,
	type PostViewModel,
} from '@/utils/i18n'
import { getPageSEO } from '@/utils/seo'

export async function getStaticPaths() {
	const posts = await getCollection('posts')
	return posts.map((post) => ({
		params: { slug: post.data.slug ?? post.id },
		props: { post },
	}))
}

interface Props {
	post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const language: Language = 'es'
const translations = getTranslations(language)

const vm: PostViewModel = {
	slug: post.data.slug ?? post.id,
	title: post.data.title,
	category: post.data.category,
	url: post.data.url,
	image: post.data.image,
	date: post.data.date,
	summary: post.data.summary[language],
	body: post.data.body[language],
	skills: post.data.skills.map((skill) => skill[language]),
}

const imageMap: Record<string, ImageMetadata> = {
	'enerlinq.com.png': enerlinqImage,
	'autosolutions.mx.png': autosolutionsImage,
	'sorteos.click.png': sorteosClickImage,
	'gerardoancer.com.png': gerardoAncerImage,
	'hackcuu.com.png': hackcuuImage,
	'petweby.com.png': petwebyImage,
}

const resolvedImage = vm.image ? imageMap[vm.image] : undefined
const portfolioUrl = getRelativeLocaleUrl(language, 'portfolio')

const seoConfig = getPageSEO('portfolio', language)
---

<Layout
  {...seoConfig}
  title={`${vm.title} - ${translations.portfolio.title}`}
  description={vm.summary}
  language={language}
  navigation={translations.navigation}
  footer={translations.footer}
>
  <article class="py-8">
    <nav class="mb-8">
      <a
        href={portfolioUrl}
        class="inline-flex items-center gap-1 text-sm font-medium text-blue-500 dark:text-blue-300 hover:underline transition-colors duration-300"
      >
        <span class="material-symbols-rounded text-base!">arrow_back</span>
        {translations.portfolio.title}
      </a>
    </nav>

    <header class="mb-8 text-center">
      <span
        class={`inline-block mb-4 px-3 py-1 text-xs font-medium rounded-full border ${vm.category === 'project' ? 'bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-200 border-blue-200 dark:border-blue-600/30' : 'bg-gold-100 dark:bg-gold-600/20 text-gold-700 dark:text-gold-200 border-gold-200 dark:border-gold-600/30'}`}
      >
        {vm.category === 'project' ? translations.portfolio.filterProjects : translations.portfolio.filterArticles}
      </span>
      <h1 class="text-4xl font-medium text-grayblue-900 dark:text-grayblue-100 transition-colors duration-300">
        {vm.title}
      </h1>
      {vm.date && (
        <time
          datetime={vm.date}
          class="mt-3 block text-sm text-grayblue-500 dark:text-grayblue-400"
        >
          {new Date(vm.date).toLocaleDateString('es-MX', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      )}
    </header>

    {resolvedImage && (
      <div class="mb-8 mx-auto max-w-3xl overflow-hidden rounded-lg shadow-lg">
        <Image
          src={resolvedImage}
          alt={vm.title}
          class="aspect-video"
          widths={[1200, 800, 400]}
        />
      </div>
    )}

    <div class="mx-auto max-w-3xl">
      <p class="text-lg leading-relaxed text-grayblue-700 dark:text-grayblue-300 transition-colors duration-300">
        {vm.body}
      </p>

      {vm.url && (
        <a
          href={vm.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-medium border border-blue-500 text-blue-500 dark:text-blue-300 transition-colors duration-300 hover:bg-blue-500 hover:text-white"
        >
          {translations.portfolio.readMore}
          <span class="material-symbols-rounded text-base!">open_in_new</span>
        </a>
      )}

      {vm.skills.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {vm.skills.map((skill) => (
            <span class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-200 rounded-full border border-blue-200 dark:border-blue-600/30 transition-colors duration-300">
              {skill}
            </span>
          ))}
        </div>
      )}
    </div>
  </article>
</Layout>
