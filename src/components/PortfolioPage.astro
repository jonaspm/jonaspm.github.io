---
import { getRelativeLocaleUrl } from 'astro:i18n'
import BioSection from '@/components/BioSection.astro'
import ContactSection from '@/components/ContactSection.astro'
import HomeSection from '@/components/HomeSection.astro'
import ProjectsSection from '@/components/ProjectsSection.astro'
import SkillsSection from '@/components/SkillsSection.astro'
import Layout from '@/layouts/Layout.astro'
import {
	listPosts,
	toPostViewModel,
	toProjectViewModel,
} from '@/utils/emdash-posts'
import { getTranslations, type Language } from '@/utils/i18n'
import { getPageSEO } from '@/utils/seo'

export interface Props {
	language: Language
}

const { language } = Astro.props
const translations = getTranslations(language)

// Posts come from EmDash (already sorted by `sort_order`); classify through
// the view-model mapper so home and listing agree on malformed rows, then map
// the surviving entries to project cards.
const projects = (await listPosts(language))
	.filter((entry) => toPostViewModel(entry).category === 'project')
	.map((entry) => toProjectViewModel(entry))

const seoConfig = getPageSEO('home', language)
const portfolioUrl = getRelativeLocaleUrl(language, 'portfolio')
---

<Layout {...seoConfig} language={language} navigation={translations.navigation} footer={translations.footer}>
  <div class="flex flex-col gap-y-18">
    <HomeSection content={translations.home} />
    <BioSection content={translations.bio} />
    <SkillsSection title={translations.skills.title} language={language} />
    <ProjectsSection title={translations.projects.title} projects={projects} viewAllHref={portfolioUrl} viewAllLabel={translations.portfolio.title} />
    <ContactSection title={translations.contact.title} />
  </div>
</Layout>