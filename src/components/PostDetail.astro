---
/**
 * Full portfolio detail page body (Layout + article).
 *
 * Receives an already-resolved view model — the locale-specific page wrappers
 * under `src/pages` (`portfolio/[slug].astro` and its es/eo variants) load it
 * via `getPost()` and handle the 404 case before rendering, so this component
 * stays presentation-only.
 */
import { getRelativeLocaleUrl } from 'astro:i18n'
import Layout from '@/layouts/Layout.astro'
import {
	getTranslations,
	type Language,
	type PostViewModel,
} from '@/utils/i18n'
import { getPageSEO } from '@/utils/seo'
import PostImage from './PostImage.astro'

export interface Props {
	post: PostViewModel
	language: Language
}

const { post, language } = Astro.props
const translations = getTranslations(language)

// Locale used for the date rendering, matching the previous per-locale pages.
const dateLocale =
	language === 'en' ? 'en-US' : language === 'es' ? 'es-MX' : 'eo'

const portfolioUrl = getRelativeLocaleUrl(language, 'portfolio')

const seoConfig = getPageSEO('portfolio', language)
---

<Layout
  {...seoConfig}
  title={`${post.title} - ${translations.portfolio.title}`}
  description={post.summary}
  language={language}
  navigation={translations.navigation}
  footer={translations.footer}
>
  <article class="py-8">
    <nav class="mb-8">
      <a
        href={portfolioUrl}
        class="inline-flex items-center gap-1 text-sm font-medium text-blue-500 dark:text-blue-300 hover:underline transition-colors duration-300"
      >
        <span class="material-symbols-rounded text-base!">arrow_back</span>
        {translations.portfolio.title}
      </a>
    </nav>

    <header class="mb-8 text-center">
      <span
        class={`inline-block mb-4 px-3 py-1 text-xs font-medium rounded-full border ${post.category === 'project' ? 'bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-200 border-blue-200 dark:border-blue-600/30' : 'bg-gold-100 dark:bg-gold-600/20 text-gold-700 dark:text-gold-200 border-gold-200 dark:border-gold-600/30'}`}
      >
        {post.category === 'project' ? translations.portfolio.filterProjects : translations.portfolio.filterArticles}
      </span>
      <h1 class="text-4xl font-medium text-grayblue-900 dark:text-grayblue-100 transition-colors duration-300">
        {post.title}
      </h1>
      {post.date && (
        <time
          datetime={post.date}
          class="mt-3 block text-sm text-grayblue-500 dark:text-grayblue-400"
        >
          {new Date(post.date).toLocaleDateString(dateLocale, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      )}
    </header>

    {post.media && (
      <div class="mb-8 mx-auto max-w-3xl overflow-hidden rounded-lg shadow-lg">
        <PostImage media={post.media} alt={post.title} class="aspect-video" />
      </div>
    )}

    <div class="mx-auto max-w-3xl">
      <p class="text-lg leading-relaxed text-grayblue-700 dark:text-grayblue-300 transition-colors duration-300">
        {post.body}
      </p>

      {post.url && (
        <a
          href={post.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-medium border border-blue-500 text-blue-500 dark:text-blue-300 transition-colors duration-300 hover:bg-blue-500 hover:text-white"
        >
          {translations.portfolio.readMore}
          <span class="material-symbols-rounded text-base!">open_in_new</span>
        </a>
      )}

      {post.skills.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {post.skills.map((skill) => (
            <span class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-200 rounded-full border border-blue-200 dark:border-blue-600/30 transition-colors duration-300">
              {skill}
            </span>
          ))}
        </div>
      )}
    </div>
  </article>
</Layout>
