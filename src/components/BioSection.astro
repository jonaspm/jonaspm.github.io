---

interface Props {
	content: {
		title: string
		paragraphs: string[]
	}
}

const { content } = Astro.props

// The last paragraph is the personal closing line (music, sports, family) —
// styled differently from the professional bio body.
const closingIndex = content.paragraphs.length - 1
---

<section id="bio" class="py-8 scroll-mt-20 opacity-0">
  <h2 class="mb-12 text-center font-display text-3xl font-semibold tracking-tight text-grayblue-900 dark:text-grayblue-100 gsap-fade-up transition-colors duration-300">{content.title}</h2>
  <div class="mx-auto max-w-3xl rounded-card-lg bg-white/80 dark:bg-grayblue-800/70 backdrop-blur-sm border border-grayblue-200/80 dark:border-grayblue-700/60 p-8 lg:p-10 shadow-soft gsap-fade-up transition-colors duration-300">
    {
      content.paragraphs.map((paragraph, index) => (
        <p
          class={`text-base lg:text-lg leading-relaxed text-grayblue-700 dark:text-grayblue-300 transition-colors duration-300${index > 0 ? " mt-4" : ""}${index === closingIndex ? " italic text-grayblue-500 dark:text-grayblue-400" : ""}`}
        >
          {paragraph}
        </p>
      ))
    }
  </div>
</section>
