---
import { Image } from 'astro:assets'
import socialNetworks from '@/assets/data/social-networks.json'
import profilePicture from '@/assets/images/profile.png'

interface Props {
	content: {
		title: string
		role: string
		subtitle: string
		description: string
		ctaPrimary: string
		ctaSecondary: string
		scrollToBioLabel: string
	}
	/** Locale-aware `/portfolio` URL for the secondary CTA. */
	portfolioUrl: string
}

const { content, portfolioUrl } = Astro.props

// Hero social row is curated to the three most relevant channels; the full
// `social-networks.json` list stays available for other consumers. The filter
// keeps the JSON as the single source of icons/URLs.
const curatedSocials = socialNetworks.filter((social) =>
	['LinkedIn', 'GitHub', 'Email'].includes(social.name),
)
---

<section id="home" class="relative py-8 scroll-mt-20 opacity-0 gsap-fade-up-noreverse">
  {/* Hero-stronger-than-rest glow (design §2.1). Decorative only; the
      hero-breathe animation is disabled under prefers-reduced-motion. */}
  <div
    class="hero-glow pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 w-[56rem] max-w-none h-[32rem] rounded-full z-0"
    style="background: radial-gradient(ellipse at center, var(--aura-blue), transparent 65%)"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 flex flex-col items-center gap-10 lg:flex-row lg:items-center lg:justify-between">
    <div class="mb-8 text-center lg:mb-0 lg:text-left lg:w-[55%]">
      <h1 class="mb-4 font-display text-4xl xs:text-5xl lg:text-6xl font-semibold tracking-tight text-grayblue-900 dark:text-grayblue-100 gsap-hero-stagger transition-colors duration-300">
        {content.title}
      </h1>
      <h2 class="mb-2 text-xl lg:text-2xl font-medium tracking-tight text-blue-600 dark:text-blue-300 gsap-hero-stagger transition-colors duration-300">
        {content.role}
      </h2>
      <h3 class="mb-6 text-lg text-grayblue-500 dark:text-grayblue-400 gsap-hero-stagger transition-colors duration-300">
        {content.subtitle}
      </h3>
      <p class="max-w-2xl text-base lg:text-lg leading-relaxed text-grayblue-600 dark:text-grayblue-300 gsap-hero-stagger transition-colors duration-300">
        {content.description}
      </p>

      {/* CTA row: in-page contact anchor + locale-aware portfolio listing. */}
      <div class="mt-8 flex flex-wrap gap-4 justify-center lg:justify-start gsap-hero-stagger">
        <a
          href="#contact"
          class="rounded-full bg-blue-600 text-white px-6 py-3 text-sm font-medium shadow-glow-blue transition-colors duration-300 hover:bg-blue-700"
        >
          {content.ctaPrimary}
        </a>
        <a
          href={portfolioUrl}
          class="rounded-full border border-blue-500/60 text-blue-600 dark:text-blue-300 px-6 py-3 text-sm font-medium transition-colors duration-300 hover:bg-blue-600 hover:text-white"
        >
          {content.ctaSecondary}
        </a>
      </div>

      <div class="mt-6 flex gap-4 justify-center lg:justify-start gsap-hero-stagger">
        {
          curatedSocials.map((socialNetwork) => (
            <a
              aria-label={socialNetwork.name}
              href={socialNetwork.url}
              class="text-grayblue-600 dark:text-grayblue-300 hover:text-blue-500 dark:hover:text-blue-300 transition-all duration-300 hover:scale-110"
            >
              <div class="h-6 w-6">
                <Fragment set:html={socialNetwork.image} />
              </div>
            </a>
          ))
        }
      </div>
    </div>

    {/* Portrait wrapped in a gradient ring (`p-1` shows the gradient around
        the circular image). */}
    <div
      class="relative h-64 w-64 overflow-hidden rounded-full p-1 bg-gradient-to-br from-blue-400 via-sky-400 to-gold-300 lg:h-80 lg:w-80 gsap-hero-stagger"
    >
      <Image
        src={profilePicture}
        alt="Jonás Perusquía Morales"
        width={320}
        height={320}
        class="rounded-full object-cover h-full w-full"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="mt-12 animate-bounce motion-reduce:animate-none text-center">
    <a href="#bio" aria-label={content.scrollToBioLabel}>
      <span
        class="material-symbols-rounded mx-auto text-5xl! text-blue-300 rotate-90"
        >chevron_right</span
      >
    </a>
  </div>
</section>
