---
import credentialsData from '@/assets/data/credentials.json'
import type { Language } from '@/utils/i18n'
import {
	type CredentialItem,
	type CredentialsData,
	formatDate,
	pick,
} from '@/utils/resume'

interface Props {
	title: string
	/** Section labels (certifications / education / …) — from `i18n.ts`. */
	labels: {
		certifications: string
		education: string
		honors: string
		languages: string
		community: string
	}
	language: Language
}

const { title, labels, language } = Astro.props

const data = credentialsData as CredentialsData

/**
 * Resolve one card's items for the active locale. A date range is rendered
 * only when both ends exist (education); open-ended items rely on their
 * `status` text instead, so no "present" UI string is needed here.
 */
const resolveItems = (items: CredentialItem[]) =>
	items.map((item) => ({
		id: item.id,
		label: pick(item.label, language),
		detail: item.detail ? pick(item.detail, language) : null,
		status: item.status ? pick(item.status, language) : null,
		dateRange:
			item.start && item.end
				? `${formatDate(item.start, language)} – ${formatDate(item.end, language)}`
				: null,
		credentialId: item.credentialId ?? null,
		url: item.url ?? null,
	}))

// Static icon + accent per card (literal class strings — Tailwind scans the
// source, so classes must not be interpolated).
const cards = [
	{
		id: 'certifications',
		label: labels.certifications,
		icon: 'workspace_premium',
		iconClasses:
			'bg-blue-500/10 text-blue-600 dark:text-blue-300 ring-blue-500/20',
		items: resolveItems(data.certifications),
	},
	{
		id: 'education',
		label: labels.education,
		icon: 'school',
		iconClasses:
			'bg-violet-500/10 text-violet-600 dark:text-violet-300 ring-violet-500/20',
		items: resolveItems(data.education),
	},
	{
		id: 'honors',
		label: labels.honors,
		icon: 'emoji_events',
		iconClasses:
			'bg-gold-500/10 text-gold-700 dark:text-gold-200 ring-gold-500/20',
		items: resolveItems(data.honors),
	},
	{
		id: 'languages',
		label: labels.languages,
		icon: 'translate',
		iconClasses:
			'bg-emerald-500/10 text-emerald-600 dark:text-emerald-300 ring-emerald-500/20',
		items: resolveItems(data.languages),
	},
]

const communityItems = resolveItems(data.community)
---

<section id="credentials" class="py-8 scroll-mt-20 opacity-0">
  <h2 class="mb-12 text-center font-display text-3xl font-semibold tracking-tight text-grayblue-900 dark:text-grayblue-100 gsap-fade-up transition-colors duration-300">{title}</h2>

  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
    {cards.map((card) => (
      <div class="rounded-card bg-white/80 dark:bg-grayblue-800/70 backdrop-blur-sm border border-grayblue-200/80 dark:border-grayblue-700/60 p-6 shadow-soft flex flex-col gap-4 transition-[transform,box-shadow,border-color] duration-300 ease-out-soft hover:shadow-lift hover:-translate-y-1 gsap-fade-up">
        <div class="flex items-center gap-3">
          <span class={`shrink-0 grid place-items-center size-10 rounded-lg ring-1 ${card.iconClasses}`} aria-hidden="true">
            <span class="material-symbols-rounded text-xl">{card.icon}</span>
          </span>
          <h3 class="text-lg font-semibold leading-tight text-grayblue-900 dark:text-grayblue-100">
            {card.label}
          </h3>
        </div>
        <ul class="flex flex-col gap-3 text-sm">
          {card.items.map((item) => (
            <li>
              {/* `dt`-ish bold label followed by compact detail lines. */}
              {item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-grayblue-900 dark:text-grayblue-100 hover:text-blue-500 dark:hover:text-blue-300 transition-colors duration-300"
                >
                  {item.label}
                </a>
              ) : (
                <p class="font-semibold text-grayblue-900 dark:text-grayblue-100">{item.label}</p>
              )}
              {item.detail && (
                <p class="text-grayblue-600 dark:text-grayblue-300">{item.detail}</p>
              )}
              {item.status && (
                <p class="text-grayblue-500 dark:text-grayblue-400 italic">{item.status}</p>
              )}
              {item.dateRange && (
                <p class="tabular-nums text-xs text-grayblue-500 dark:text-grayblue-400">{item.dateRange}</p>
              )}
              {item.credentialId && (
                <p class="tabular-nums text-xs text-grayblue-500 dark:text-grayblue-400">ID · {item.credentialId}</p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  {/* Community & speaking strip — static resume items that are not EmDash
      posts (never fabricated as CMS content). `url` is null until verified,
      so items render as plain text. */}
  <div class="mt-6 rounded-card-lg bg-white/80 dark:bg-grayblue-800/70 backdrop-blur-sm border border-grayblue-200/80 dark:border-grayblue-700/60 p-8 shadow-soft gsap-fade-up">
    <h3 class="mb-4 flex items-center gap-3 text-lg font-semibold leading-tight text-grayblue-900 dark:text-grayblue-100">
      <span class="shrink-0 grid place-items-center size-10 rounded-lg ring-1 bg-sky-500/10 text-sky-600 dark:text-sky-300 ring-sky-500/20" aria-hidden="true">
        <span class="material-symbols-rounded text-xl">campaign</span>
      </span>
      {labels.community}
    </h3>
    <ul class="flex flex-wrap gap-x-8 gap-y-3 text-grayblue-600 dark:text-grayblue-300">
      {communityItems.map((item) => (
        <li class="max-w-md">
          {item.url ? (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-blue-500 dark:hover:text-blue-300 transition-colors duration-300"
            >
              {item.label}
            </a>
          ) : (
            item.label
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
