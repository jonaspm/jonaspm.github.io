---
import { Image } from 'astro:assets'
import { type CollectionEntry, getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'
import autosolutionsImage from '@/assets/images/autosolutions.mx.png'
import enerlinqImage from '@/assets/images/enerlinq.com.png'
import gerardoAncerImage from '@/assets/images/gerardoancer.com.png'
import hackcuuImage from '@/assets/images/hackcuu.com.png'
import petwebyImage from '@/assets/images/petweby.com.png'
import sorteosClickImage from '@/assets/images/sorteos.click.png'
import {
	getTranslations,
	type Language,
	type PostViewModel,
} from '@/utils/i18n'

export interface Props {
	language: Language
}

const { language } = Astro.props
const translations = getTranslations(language)

const posts = (await getCollection('posts'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((post): PostViewModel => localizePost(post, language))

// Map image filenames to imported images
const imageMap: Record<string, ImageMetadata> = {
	'enerlinq.com.png': enerlinqImage,
	'autosolutions.mx.png': autosolutionsImage,
	'sorteos.click.png': sorteosClickImage,
	'gerardoancer.com.png': gerardoAncerImage,
	'hackcuu.com.png': hackcuuImage,
	'petweby.com.png': petwebyImage,
}

const resolvedPosts = posts.map((post) => ({
	...post,
	image: post.image ? imageMap[post.image] : undefined,
}))

function localizePost(
	post: CollectionEntry<'posts'>,
	currentLanguage: Language,
): PostViewModel {
	return {
		slug: post.data.slug ?? post.id,
		title: post.data.title,
		category: post.data.category,
		url: post.data.url,
		image: post.data.image,
		date: post.data.date,
		summary: post.data.summary[currentLanguage],
		body: post.data.body[currentLanguage],
		skills: post.data.skills.map((skill) => skill[currentLanguage]),
	}
}

const portfolioUrl = getRelativeLocaleUrl(language, 'portfolio')
const detailPathFor = (slug: string) => `${portfolioUrl}/${slug}`
---

<section class="py-8">
  <h1 class="mb-4 text-center text-3xl font-medium text-grayblue-900 dark:text-grayblue-100 transition-colors duration-300">
    {translations.portfolio.title}
  </h1>
  <p class="mb-10 text-center text-lg text-grayblue-600 dark:text-grayblue-300 transition-colors duration-300">
    {translations.portfolio.description}
  </p>

  <!-- Category filter -->
  <div class="mb-10 flex justify-center gap-3">
    <button
      type="button"
      data-filter="all"
      data-active
      class="px-4 py-2 rounded-full text-sm font-medium border transition-colors duration-300 border-blue-500 bg-blue-500 text-white"
    >
      {translations.portfolio.filterAll}
    </button>
    <button
      type="button"
      data-filter="project"
      class="px-4 py-2 rounded-full text-sm font-medium border transition-colors duration-300 border-grayblue-200 dark:border-grayblue-700 text-grayblue-600 dark:text-grayblue-300 hover:border-blue-500 hover:text-blue-500"
    >
      {translations.portfolio.filterProjects}
    </button>
    <button
      type="button"
      data-filter="article"
      class="px-4 py-2 rounded-full text-sm font-medium border transition-colors duration-300 border-grayblue-200 dark:border-grayblue-700 text-grayblue-600 dark:text-grayblue-300 hover:border-blue-500 hover:text-blue-500"
    >
      {translations.portfolio.filterArticles}
    </button>
  </div>

  <!-- Post grid -->
  <div class="grid gap-8 md:grid-cols-2" data-portfolio-grid>
    {
      resolvedPosts.map((post) => (
        <article
          data-category={post.category}
          class="rounded-lg bg-white dark:bg-grayblue-800 border border-grayblue-200 dark:border-grayblue-700 p-6 shadow-lg flex flex-col transition-colors duration-300 hover:shadow-xl"
        >
          <a href={detailPathFor(post.slug)} class="flex flex-col gap-4 grow">
            {post.image && (
              <div class="overflow-hidden aspect-video rounded-lg">
                <Image
                  src={post.image}
                  alt={post.title}
                  loading="lazy"
                  class="duration-300 transition-all aspect-video"
                  widths={[600, 400, 300]}
                />
              </div>
            )}
            <div class="flex flex-col gap-3 grow">
              <div class="flex items-center justify-between gap-3">
                <h2 class="text-xl font-semibold text-blue-500 dark:text-blue-300 transition-colors duration-300">
                  {post.title}
                </h2>
                <span
                  class={`px-2 py-1 text-xs font-medium rounded-full border whitespace-nowrap ${post.category === 'project' ? 'bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-200 border-blue-200 dark:border-blue-600/30' : 'bg-gold-100 dark:bg-gold-600/20 text-gold-700 dark:text-gold-200 border-gold-200 dark:border-gold-600/30'}`}
                >
                  {post.category === 'project' ? translations.portfolio.filterProjects : translations.portfolio.filterArticles}
                </span>
              </div>
              <p class="text-grayblue-600 dark:text-grayblue-300 transition-colors duration-300">
                {post.summary}
              </p>
              {post.skills.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-auto">
                  {post.skills.map((skill) => (
                    <span class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-200 rounded-full border border-blue-200 dark:border-blue-600/30 transition-colors duration-300">
                      {skill}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        </article>
      ))
    }
  </div>

  <!-- Empty state -->
  <p data-portfolio-empty class="hidden text-center text-lg text-grayblue-500 dark:text-grayblue-400 py-12">
    {translations.portfolio.empty}
  </p>
</section>

<script>
  class PortfolioFilter {
    private filters: NodeListOf<HTMLButtonElement> = document.querySelectorAll(
      '[data-filter]',
    )
    private cards: NodeListOf<HTMLElement> = document.querySelectorAll(
      '[data-portfolio-grid] [data-category]',
    )
    private empty: HTMLElement | null = document.querySelector(
      '[data-portfolio-empty]',
    )

    init() {
      this.filters = document.querySelectorAll(
        '[data-filter]',
      )
      this.cards = document.querySelectorAll(
        '[data-portfolio-grid] [data-category]',
      )
      this.empty = document.querySelector('[data-portfolio-empty]')

      this.filters.forEach((button) => {
        button.onclick = () => this.handleClick(button)
      })
    }

    handleClick(button: HTMLButtonElement) {
      const filter = button.getAttribute('data-filter')

      this.filters.forEach((b) => {
        const active = b === button
        b.toggleAttribute('data-active', active)
        if (active) {
          b.classList.add('border-blue-500', 'bg-blue-500', 'text-white')
          b.classList.remove(
            'border-grayblue-200',
            'dark:border-grayblue-700',
            'text-grayblue-600',
            'dark:text-grayblue-300',
            'hover:border-blue-500',
            'hover:text-blue-500',
          )
        } else {
          b.classList.remove('border-blue-500', 'bg-blue-500', 'text-white')
          b.classList.add(
            'border-grayblue-200',
            'dark:border-grayblue-700',
            'text-grayblue-600',
            'dark:text-grayblue-300',
            'hover:border-blue-500',
            'hover:text-blue-500',
          )
        }
      })

      let visible = 0
      this.cards.forEach((card) => {
        const category = card.getAttribute('data-category')
        const show = filter === 'all' || category === filter
        card.classList.toggle('hidden', !show)
        if (show) visible++
      })

      if (this.empty) {
        this.empty.classList.toggle('hidden', visible !== 0)
      }
    }
  }

  const filter = new PortfolioFilter()
  filter.init()
  document.addEventListener('astro:page-load', () => filter.init())
</script>
