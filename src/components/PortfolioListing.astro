---
import type { Translations } from '@/utils/i18n'

export interface PortfolioPost {
	slug: string
	title: string
	description: string
	publishedAt: string
	heroImage: string | null
	tags: string[]
	categories: string[]
}

interface Props {
	title: string
	t: Translations['portfolio']
	posts: PortfolioPost[]
	activeCategory: 'all' | 'project' | 'article'
	baseUrl: string
	locale: string
}

const { title, t, posts, activeCategory, baseUrl, locale } = Astro.props

const filters = [
	{ key: 'all', label: t.filterAll },
	{ key: 'project', label: t.filterProjects },
	{ key: 'article', label: t.filterArticles },
] as const

const dateFormatter = new Intl.DateTimeFormat(locale, {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
})

function formatDate(date: string): string {
	return dateFormatter.format(new Date(date))
}
---

<section class="py-8 scroll-mt-20">
  <h2 class="mb-12 text-center text-3xl font-medium text-grayblue-900 dark:text-grayblue-100 gsap-fade-up transition-colors duration-300">
    {title}
  </h2>

  <div class="mb-10 flex justify-center gap-2 gsap-fade-up">
    {
      filters.map((filter) => (
        <a
          href={filter.key === 'all' ? baseUrl : `${baseUrl}?category=${filter.key}`}
          class:list={[
            'px-4 py-2 rounded-full text-sm font-medium transition-colors duration-300 border',
            activeCategory === filter.key
              ? 'bg-blue-500 text-white border-blue-500 dark:bg-blue-600 dark:border-blue-600'
              : 'text-grayblue-600 dark:text-grayblue-300 border-grayblue-300 dark:border-grayblue-600 hover:border-blue-500 dark:hover:border-blue-400 hover:text-blue-500 dark:hover:text-blue-300',
          ]}
        >
          {filter.label}
        </a>
      ))
    }
  </div>

  {
    posts.length === 0 ? (
      <div class="text-center py-16 gsap-fade-up">
        <h3 class="text-xl font-semibold text-grayblue-900 dark:text-grayblue-100 mb-3 transition-colors duration-300">
          {t.emptyTitle}
        </h3>
        <p class="text-grayblue-600 dark:text-grayblue-300 transition-colors duration-300">{t.emptyText}</p>
      </div>
    ) : (
      <div class="grid gap-8 md:grid-cols-2">
        {
          posts.map((post) => (
            <a
              href={`${baseUrl}/${post.slug}`}
              class="rounded-lg bg-white dark:bg-grayblue-800 border border-grayblue-200 dark:border-grayblue-700 p-6 shadow-lg flex flex-col gap-4 gsap-fade-up transition-colors duration-300 hover:shadow-xl"
            >
              <div class="flex flex-col gap-3 flex-1">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-xl font-semibold text-blue-500 dark:text-blue-300 transition-colors duration-300">
                    {post.title}
                  </h3>
                  <time datetime={post.publishedAt} class="shrink-0 text-xs text-grayblue-500 dark:text-grayblue-400">
                    {formatDate(post.publishedAt)}
                  </time>
                </div>
                <p class="text-grayblue-600 dark:text-grayblue-300 transition-colors duration-300">{post.description}</p>
                <div class="flex flex-wrap gap-2 mt-2">
                  {
                    post.categories.map((category) => (
                      <span class="px-2 py-1 text-xs font-medium bg-gold-100 dark:bg-gold-600/20 text-gold-600 dark:text-gold-300 rounded-full border border-gold-200 dark:border-gold-600/30 transition-colors duration-300">
                        {category}
                      </span>
                    ))
                  }
                  {post.tags.map((tag) => (
                    <span class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-200 rounded-full border border-blue-200 dark:border-blue-600/30 transition-colors duration-300">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <span class="text-sm font-medium text-blue-500 dark:text-blue-300 transition-colors duration-300">
                {t.readMore} →
              </span>
            </a>
          ))
        }
      </div>
    )
  }
</section>
