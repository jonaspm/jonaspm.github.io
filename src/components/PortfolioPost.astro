---
import type { Translations } from '@/utils/i18n'
import { Markdown } from 'studiocms:markdown-remark'

interface PostView {
	title: string
	description: string
	publishedAt: string
	heroImage: string | null
	categories: Array<{ name: string; slug: string }>
	tags: Array<{ name: string; slug: string }>
	content: string
}

interface Props {
	t: Translations['portfolio']
	post: PostView
	baseUrl: string
	locale: string
}

const { t, post, baseUrl, locale } = Astro.props

const dateFormatter = new Intl.DateTimeFormat(locale, {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
})
---

<article class="py-8 max-w-3xl mx-auto">
  <a
    href={baseUrl}
    class="inline-block mb-8 text-sm font-medium text-blue-500 dark:text-blue-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-300"
  >
    ← {t.backToPortfolio}
  </a>

  <header class="mb-10 gsap-fade-up">
    <h1 class="text-4xl font-medium text-grayblue-900 dark:text-grayblue-100 mb-4 transition-colors duration-300">
      {post.title}
    </h1>
    <div class="flex flex-wrap items-center gap-3">
      <time datetime={post.publishedAt} class="text-sm text-grayblue-500 dark:text-grayblue-400">
        {dateFormatter.format(new Date(post.publishedAt))}
      </time>
      {
        post.categories.map((category) => (
          <span class="px-2 py-1 text-xs font-medium bg-gold-100 dark:bg-gold-600/20 text-gold-600 dark:text-gold-300 rounded-full border border-gold-200 dark:border-gold-600/30 transition-colors duration-300">
            {category.name}
          </span>
        ))
      }
    </div>
  </header>

  {
    post.heroImage && (
      <div class="mb-10 overflow-hidden rounded-lg gsap-fade-up">
        <img src={post.heroImage} alt={post.title} class="w-full object-cover" />
      </div>
    )
  }

  <div class="portfolio-prose gsap-fade-up">
    <Markdown content={post.content} />
  </div>

  {
    post.tags.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-2">
        {post.tags.map((tag) => (
          <span class="px-2 py-1 text-xs font-medium bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-200 rounded-full border border-blue-200 dark:border-blue-600/30 transition-colors duration-300">
            {tag.name}
          </span>
        ))}
      </div>
    )
  }
</article>
