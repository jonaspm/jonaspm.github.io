{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/emdash-env.d.ts",
			"!**/.emdash",
			"!dist",
			"!**/.astro",
			"!**/.wrangler",
			"!**/src/styles/global.css",
			"!**/skills-lock.json"
		]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"javascript": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"bracketSameLine": false
		}
	},
	"formatter": {
		"enabled": true,
		"lineEnding": "crlf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	}
}
